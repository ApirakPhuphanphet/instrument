# Use either DATABASE_URL or the individual PostgreSQL settings below.
DATABASE_URL=postgresql://postgres:password@localhost:5432/dbname

# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ctf
# DB_USER=postgres
# DB_PASSWORD=password
# DB_SSL=false

PORT=3000

# Authentication & JWT Configuration
JWT_SECRET=eshub-instrument-tracking-secret-key-2026

# MQTT Broker Configuration (Free Public Broker: EMQX)
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_CLIENT_ID_PREFIX=instrument_backend_
MQTT_DEFAULT_TIMEOUT_MS=5000
